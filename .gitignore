# Where tools/bench_in_container.py writes a run's JUnit report and log by
# default: evidence of one run on one board, not content.
bench-results/
# Redirected APPDATA/LOCALAPPDATA for a local test run; environment, not content.
.testenv/
# Never committed anywhere, including the plugin: a portable plugin cannot embed
# the verified absolute path of a persistent executable, and the release job
# refuses a build that ships one.
.mcp.json
uv.lock
evals/install/artifacts/

# Worktrees this session creates are checkouts, not content.
.claude/worktrees/

# Review documents and transcripts from tools/agent_review_loop.py: a record of
# how a change was produced, not the change.
.agentic-loop/

# Editor/agent-local configuration, never part of the product
.claude/
