{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-hil.local/schemas/testconfig.schema.json",
  "title": "Agentic HIL test reactor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "steps"],
  "properties": {
    "version": { "const": 2, "description": "Format version. Version 1 addressed a `device:` that no longer exists; steps now name a `debuggers` entry, a `com_ports` entry or a `can_buses` entry directly." },
    "name": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/flash" },
          { "$ref": "#/$defs/reset" },
          { "$ref": "#/$defs/uartOpen" },
          { "$ref": "#/$defs/uartExpect" },
          { "$ref": "#/$defs/uartClose" },
          { "$ref": "#/$defs/canOpen" },
          { "$ref": "#/$defs/canClose" },
          { "$ref": "#/$defs/canSend" },
          { "$ref": "#/$defs/canRead" },
          { "$ref": "#/$defs/debugStart" },
          { "$ref": "#/$defs/runUntilBreakpoint" },
          { "$ref": "#/$defs/dumpMemory" },
          { "$ref": "#/$defs/debugStop" }
        ]
      }
    }
  },
  "$defs": {
    "debugger": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "description": "Name of a debuggers.<name> entry. Optional when the project configures exactly one debugger; required when it configures several." },
    "portId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "description": "Name of a com_ports.<name> entry." },
    "busId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "description": "Name of a can_buses.<name> entry." },
    "path": { "type": "string", "minLength": 1 },
    "timeout": { "type": "number", "minimum": 0 },
    "positiveTimeout": { "type": "number", "exclusiveMinimum": 0, "description": "A deadline a step waits out. Zero is refused rather than read as 'do not wait': a step whose whole purpose is to wait has no useful reading of no time at all." },
    "location": {
      "oneOf": [
        { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol"],
          "properties": {
            "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["function"],
          "properties": {
            "function": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line"],
          "properties": {
            "file": { "type": "string", "pattern": "^[A-Za-z0-9_./\\\\:-]+$", "not": { "pattern": "(?:^|[/\\\\])\\.\\.(?:$|[/\\\\])" } },
            "line": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "flash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "image_path"],
      "properties": {
        "debugger": { "$ref": "#/$defs/debugger" },
        "action": { "const": "flash" },
        "image_path": { "$ref": "#/$defs/path" },
        "reset_after_flash": { "type": "boolean", "default": false }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "description": "Reset the target through the named debugger, exactly as the `reset_target` tool does. A backend that cannot run the requested mode refuses it with its own `not_supported`; the step reports that refusal unchanged.",
      "properties": {
        "debugger": { "$ref": "#/$defs/debugger" },
        "action": { "const": "reset" },
        "mode": { "type": "string", "enum": ["run", "halt", "init"], "default": "run", "description": "How the target is left afterwards. 'run' resets and lets the target execute. 'halt' leaves the core stopped. 'init' additionally runs the target's reset-init event script and is OpenOCD-only." }
      }
    },
    "uartOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "port_id"],
      "properties": {
        "port_id": { "$ref": "#/$defs/portId" },
        "action": { "const": "uart_open" },
        "clear_buffer": { "type": "boolean", "default": true, "description": "Discard whatever the line buffered before this step, so what a later `uart_expect` matches came from this run rather than from a previous one. Opening a port a plan may not read is already refused, so the clear this asks for is always permitted here." }
      }
    },
    "uartExpect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "port_id", "timeout_s"],
      "description": "Wait for output on a serial line this plan has opened. Reads the port the same way `com_read` does and matches against everything read so far, so output that arrives in pieces still counts. A step whose expectation never appears fails with the tail of what the port did say. Exactly one of `text` and `pattern` says what to wait for: a step carrying both, or neither, is refused before the run starts.",
      "oneOf": [
        { "required": ["text"], "not": { "required": ["pattern"] } },
        { "required": ["pattern"], "not": { "required": ["text"] } }
      ],
      "properties": {
        "port_id": { "$ref": "#/$defs/portId" },
        "action": { "const": "uart_expect" },
        "text": { "type": "string", "minLength": 1, "description": "The substring the port's output must contain. Mutually exclusive with `pattern`." },
        "pattern": { "type": "string", "minLength": 1, "description": "A Python regular expression the port's output must match, with `re.search` semantics: it is anchored where it is written and nowhere else, so write `^` or `$` when the position is part of the claim. Use this to check that the board answered with the right value — a counter, a measurement, a version string — rather than merely that it answered. A pattern that does not compile is refused before the run starts. Mutually exclusive with `text`." },
        "timeout_s": { "$ref": "#/$defs/positiveTimeout" }
      }
    },
    "uartClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "port_id"],
      "properties": {
        "port_id": { "$ref": "#/$defs/portId" },
        "action": { "const": "uart_close" }
      }
    },
    "canOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "bus_id"],
      "properties": {
        "bus_id": { "$ref": "#/$defs/busId" },
        "action": { "const": "can_open" },
        "clear_rx_queue": { "type": "boolean", "default": true, "description": "Drain the receive queue before the plan reads. Requires permissions.allow_read on the bus." }
      }
    },
    "canClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "bus_id"],
      "properties": {
        "bus_id": { "$ref": "#/$defs/busId" },
        "action": { "const": "can_close" }
      }
    },
    "canSend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "bus_id", "frame_id"],
      "description": "One classic CAN frame on a bus this plan opened. Refused before the run on a bus configured `listen_only: true`, which is the claim that observing it sends nothing.",
      "properties": {
        "bus_id": { "$ref": "#/$defs/busId" },
        "action": { "const": "can_send" },
        "frame_id": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^(?:0[xX][0-9A-Fa-f]+|[0-9]+)$" }] },
        "extended": { "type": "boolean", "default": false },
        "rtr": { "type": "boolean", "default": false },
        "data_hex": { "type": "string", "pattern": "^[0-9A-Fa-f\\s]*$", "default": "" }
      }
    },
    "canRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "bus_id"],
      "properties": {
        "bus_id": { "$ref": "#/$defs/busId" },
        "action": { "const": "can_read" },
        "max_frames": { "type": "integer", "minimum": 1, "description": "Defaults to the bus's configured max_buffer_frames, which is also the ceiling." },
        "wait_timeout_s": { "$ref": "#/$defs/timeout" }
      }
    },
    "debugStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "image_path"],
      "properties": {
        "debugger": { "$ref": "#/$defs/debugger" },
        "action": { "const": "debug_start" },
        "image_path": { "$ref": "#/$defs/path" },
        "mode": { "type": "string", "enum": ["attach", "reset_halt", "load"], "default": "attach" },
        "timeout_s": { "$ref": "#/$defs/timeout" }
      }
    },
    "runUntilBreakpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "location"],
      "properties": {
        "debugger": { "$ref": "#/$defs/debugger" },
        "action": { "const": "run_until_breakpoint" },
        "location": { "$ref": "#/$defs/location" },
        "timeout_s": { "$ref": "#/$defs/timeout" }
      }
    },
    "dumpMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "symbol", "output_path"],
      "properties": {
        "debugger": { "$ref": "#/$defs/debugger" },
        "action": { "const": "dump_memory" },
        "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$" },
        "output_path": { "$ref": "#/$defs/path" }
      }
    },
    "debugStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "debugger": { "$ref": "#/$defs/debugger" },
        "action": { "const": "debug_stop" },
        "timeout_s": { "$ref": "#/$defs/timeout" }
      }
    }
  }
}
