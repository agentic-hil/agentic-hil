+
+/* The devicetree binding gives buffer-size a default of 0, so the property
+ * always has a value and DT_INST_PROP_OR never reaches its fallback: a node
+ * that leaves buffer-size out gets a zero-length buffer and every request
+ * fails with -ENOMEM. A 0 now selects the build-time default, as the binding
+ * describes it. The array holds one word more, for the trailing idle word
+ * encode() appends; buffer-size keeps meaning the words one submission carries.
+ */
+#define PULSE_IO_STM32_BUFSZ(inst)                                                  \
+	(DT_INST_PROP_OR(inst, buffer_size, 0) > 0 ?                                \
+	 DT_INST_PROP_OR(inst, buffer_size, 0) : PULSE_IO_STM32_DEFAULT_BUFSZ)

