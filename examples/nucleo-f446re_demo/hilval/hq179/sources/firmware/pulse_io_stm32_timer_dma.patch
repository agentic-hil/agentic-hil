-	arr = (uint32_t)(tick_freq / cfg->resolution_hz);
-
-	if (arr == 0U) {
-		arr = 1U;
-	}
+	uint32_t period = (uint32_t)(tick_freq / cfg->resolution_hz);
+
+	/* One tick is one whole update period, so the reload value is one less
+	 * than the number of clocks in a tick. Two clocks is the shortest
+	 * period this can program, the same floor the old lower clamp gave.
+	 */
+	if (period < 2U) {
+		period = 2U;
+	}
+	arr = period - 1U;
