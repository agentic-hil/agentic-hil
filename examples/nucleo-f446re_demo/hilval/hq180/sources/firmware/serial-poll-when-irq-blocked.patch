+/**
+ * Whether the UART interrupt cannot run in the caller's context, so that a
+ * caller waiting for it has to run the handler itself
+ *
+ * An exception is taken only when its group priority is numerically lower than
+ * the priority the processor executes at, so an interrupt of equal priority
+ * does not preempt. PRIMASK, FAULTMASK and BASEPRI hold interrupts off as the
+ * architecture defines them, and a line the NVIC has not enabled is never
+ * taken at all.
+ *
+ * @param obj The serial object
+ * @return true when the interrupt cannot run from here, false when it can
+ */
+bool uart_irq_blocked(serial_t *obj)
+{
+  uint32_t group, ipsr, uart_preempt, uart_sub;
+
+  if (obj == NULL) {
+    return false;
+  }
+  if (__get_PRIMASK() != 0U) {
+    return true;
+  }
+#if UART_HAS_BASEPRI
+  if (__get_FAULTMASK() != 0U) {
+    return true;
+  }
+#endif
+  if (NVIC_GetEnableIRQ(obj->irq) == 0U) {
+    return true;
+  }
+  group = NVIC_GetPriorityGrouping();
+  NVIC_DecodePriority(NVIC_GetPriority(obj->irq), group, &uart_preempt, &uart_sub);
+#if UART_HAS_BASEPRI
+  {
+    uint32_t basepri = __get_BASEPRI();
+    /* BASEPRI masks every priority numerically at or above its value. */
+    if ((basepri != 0U)
+        && ((NVIC_GetPriority(obj->irq) << (8U - __NVIC_PRIO_BITS)) >= basepri)) {
+      return true;
+    }
+  }
+#endif
+  ipsr = __get_IPSR();
+  if (ipsr != 0U) {
+    uint32_t active_preempt, active_sub;
+    if (ipsr < 4U) {
+      /* Reset, NMI and HardFault run above anything the NVIC can mask. */
+      return true;
+    }
+    NVIC_DecodePriority(NVIC_GetPriority((IRQn_Type)((int32_t)ipsr - 16)), group,
+                        &active_preempt, &active_sub);
+    if (uart_preempt >= active_preempt) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/**
+ * Run the UART interrupt handler for a caller the interrupt cannot serve
+ *
+ * The caller has established that the interrupt cannot be taken here, so the
+ * handler cannot run concurrently with itself. The pending bit the hardware
+ * sets meanwhile makes the real handler run once the context unblocks, where
+ * it finds no enabled flag left to serve.
+ *
+ * @param obj The serial object
+ * @retval none
+ */
+void uart_poll_irq(serial_t *obj)
+{
+  if ((obj == NULL) || (obj->index >= UART_NUM) || (uart_handlers[obj->index] == NULL)) {
+    return;
+  }
+  HAL_UART_IRQHandler(uart_handlers[obj->index]);
+}
+
+/**
+ * Stop the transfer the hardware is running and report how much of it is gone
+ *
+ * Every byte the handler has written to the data register is sent whatever
+ * happens next, so those are the bytes the caller must count as sent.
+ *
+ * @param obj The serial object
+ * @return bytes of the stopped transfer that reached the hardware, 0 if none
+ *         was running
+ */
+size_t uart_abort_tx(serial_t *obj)
+{
+  size_t written = 0;
+
+  if ((obj == NULL) || (obj->index >= UART_NUM) || (uart_handlers[obj->index] == NULL)) {
+    return written;
+  }
+#if defined(USE_HALV2_DRIVER)
+  /* No HAL v2 series was available to check an abort against. Reporting that
+   * nothing left the buffer makes the caller drop nothing, which leaves a
+   * flush timeout behaving as it does without this function. */
+#else
+  /* Must disable interrupt to prevent handle lock contention */
+  HAL_NVIC_DisableIRQ(obj->irq);
+  if (serial_tx_active(obj)) {
+    UART_HandleTypeDef *handle = uart_handlers[obj->index];
+    written = (size_t)(handle->TxXferSize - handle->TxXferCount);
+    HAL_UART_AbortTransmit(handle);
+  }
+  /* Enable interrupt */
+  HAL_NVIC_EnableIRQ(obj->irq);
+#endif
+  return written;
+}
