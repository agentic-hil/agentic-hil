+/**
+ * The milliseconds that have passed since the previous call
+ *
+ * Counted from the SysTick counter, not from HAL_GetTick(), which stands still
+ * whenever the SysTick exception is held off. The counter keeps reloading and
+ * COUNTFLAG stays set until it is read, so one call per wait iteration counts
+ * every reload once. HAL_IncTick() does not read CTRL, so this does not
+ * disturb the HAL's own tick where the exception does run.
+ *
+ * @return the milliseconds counted since the previous call: 0 or one tick
+ */
+uint32_t uart_tick_elapsed(void)
+{
+  if ((SysTick->CTRL & SysTick_CTRL_COUNTFLAG_Msk) != 0U) {
+    return (uint32_t)HAL_GetTickFreq();
+  }
+  return 0U;
+}
