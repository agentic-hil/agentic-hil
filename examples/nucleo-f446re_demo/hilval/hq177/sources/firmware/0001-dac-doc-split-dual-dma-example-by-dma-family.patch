dac: split the dual-DAC DMA example by DMA family

libopencm3 issue #528: the dual-DAC DMA example in the shared Doxygen text of
lib/stm32/common/dac_common_all.c is written against the channel DMA API and
does not fit the STM32F2/F4 stream DMA controller. It names DMA2 channel 3 and
DMA_CCR_* fields that those devices do not have, takes the address of
DAC_DHR8RD, which is now a macro with a dac argument, and never says how the
two channels' values are packed into one dual data register.

This splits the section into one subsection per DMA controller. The existing
channel-API example stays byte for byte where it is, under a heading that says
which devices it is for, and a second subsection adds the stream-API example:
two 12-bit samples packed explicitly into DAC_DHR12RD, one timer TRGO
triggering both channels, 32-bit transfers, and the DAC channel 1 request
served by DMA1 stream 5 on channel 7 of an STM32F446. The other families' text
is not touched, so no global replacement can change it.

The added example is the code that ran on a NUCLEO-F446RE with both DAC
outputs read back by ADC1 on the same pins; firmware/hq177/README.md beside
this patch says how it was checked.

diff --git a/lib/stm32/common/dac_common_all.c b/lib/stm32/common/dac_common_all.c
--- a/lib/stm32/common/dac_common_all.c
+++ b/lib/stm32/common/dac_common_all.c
@@ -79,6 +79,15 @@

 @section dac_api_dma_ex Simultaneous Dual DAC with DMA.

+The DMA controller differs between families, so this section has one example
+for each. Devices with a channel DMA controller, as declared in
+dma_common_l1f013.h, follow the first one; devices with a stream DMA
+controller, as declared in dma_common_f24.h, follow the second. In both, DMA
+is enabled for DAC channel 1 only, so that one request per trigger carries
+one word in a dual format and both channels follow the same trigger.
+
+@subsection dac_api_dma_ex_channel Channel DMA controllers
+
 This example in part sets up the DAC channel 1 DMA (DMA2 channel 3) to read
 16 bit data from memory into the right-aligned 8 bit dual register DAC_DHR8RD.
 Both DAC channels are enabled, and both triggers are set to the same timer
@@ -99,4 +108,69 @@
 @endcode
+
+@note On current headers the dual data registers take the DAC base address as
+an argument: the address above is now (uint32_t)&DAC_DHR8RD(DAC1).
+
+@subsection dac_api_dma_ex_stream Stream DMA controllers (F2, F4, F7)
+
+On the STM32F446 the DAC channel 1 request is served by DMA1 stream 5 on
+channel 7 (DAC channel 2 is stream 6 on the same channel); the DMA request
+mapping of the reference manual gives the pair for another device. The
+example packs two 12-bit right-aligned samples into one 32-bit word with the
+layout of DAC_DHR12RD, channel 1 in bits 11:0 and channel 2 in bits 27:16,
+and the stream copies one word per request into that register. The update
+event of TIM7, as its TRGO, triggers both DAC channels, and the UG event
+loads the prescaler before the DAC listens to TRGO. DMA is enabled for
+channel 1 only, so each trigger raises exactly one request: the first
+trigger outputs the pair loaded with @ref dac_load_data_buffer_dual, every
+later one the word the DMA fetched after the trigger before it. ch1 and ch2
+hold count samples each, and words has room for count words.
+
+@code
+	for (uint16_t i = 0; i < count; i++) {
+		words[i] = (ch1[i] & DAC_DHR12RD_DACC1DHR_MSK) |
+			   ((uint32_t)(ch2[i] & DAC_DHR12RD_DACC2DHR_MASK)
+			    << DAC_DHR12RD_DACC2DHR_SHIFT);
+	}
+
+	rcc_periph_clock_enable(RCC_GPIOA);
+	rcc_periph_clock_enable(RCC_DAC);
+	rcc_periph_clock_enable(RCC_DMA1);
+	rcc_periph_clock_enable(RCC_TIM7);
+	gpio_mode_setup(GPIOA, GPIO_MODE_ANALOG, GPIO_PUPD_NONE, GPIO4 | GPIO5);
+
+	timer_set_prescaler(TIM7, prescaler);
+	timer_set_period(TIM7, period);
+	timer_generate_event(TIM7, TIM_EGR_UG);
+	timer_clear_flag(TIM7, TIM_SR_UIF);
+	timer_set_master_mode(TIM7, TIM_CR2_MMS_UPDATE);
+
+	dma_stream_reset(DMA1, DMA_STREAM5);
+	dma_channel_select(DMA1, DMA_STREAM5, DMA_SxCR_CHSEL_7);
+	dma_set_transfer_mode(DMA1, DMA_STREAM5,
+			      DMA_SxCR_DIR_MEM_TO_PERIPHERAL);
+	dma_set_peripheral_address(DMA1, DMA_STREAM5,
+				   (uint32_t)&DAC_DHR12RD(DAC1));
+	dma_set_peripheral_size(DMA1, DMA_STREAM5, DMA_SxCR_PSIZE_32BIT);
+	dma_set_memory_address(DMA1, DMA_STREAM5, (uint32_t)words);
+	dma_set_memory_size(DMA1, DMA_STREAM5, DMA_SxCR_MSIZE_32BIT);
+	dma_enable_memory_increment_mode(DMA1, DMA_STREAM5);
+	dma_set_number_of_data(DMA1, DMA_STREAM5, count);
+	dma_enable_circular_mode(DMA1, DMA_STREAM5);
+	dma_enable_direct_mode(DMA1, DMA_STREAM5);
+	dma_set_priority(DMA1, DMA_STREAM5, DMA_SxCR_PL_HIGH);
+	dma_enable_stream(DMA1, DMA_STREAM5);
+
+	dac_trigger_enable(DAC1, DAC_CHANNEL_BOTH);
+	dac_set_trigger_source(DAC1, DAC_CR_TSEL1_T7 | DAC_CR_TSEL2_T7);
+	dac_dma_enable(DAC1, DAC_CHANNEL1);
+	dac_load_data_buffer_dual(DAC1, ch1[count - 1], ch2[count - 1],
+				  DAC_ALIGN_RIGHT12);
+	dac_enable(DAC1, DAC_CHANNEL_BOTH);
+	timer_enable_counter(TIM7);
+@endcode
+
+@note This sequence was run on an STM32F446 with both DAC outputs read back
+by ADC1 on the same pins, PA4 and PA5.

